"""
osc_callbacks.dat — Callbacks para osc_in1_callbacks (OSC In DAT).

Vinculacion en TD:
  - Abrir el componente osc_in1
  - Seleccionar osc_in1_callbacks (el DAT interno)
  - Parametros: File -> td/osc_callbacks.dat, Sync to File = ON

Mensajes manejados:
  /flujos/elecciones/<id>  -> elec_<id> (tablas de elecciones, VIVO: alimentan la UI de botones)
  /flujos/colores          -> tabla_colores   (ops aun no recreadas: pipeline visual en construccion)
  /colores                 -> color individual (idem)
  /flujos/slideshow/imagen -> movie1 + info_imagen (idem)
  /slideshow/imagen        -> idem (alternativo)
  /flujos/seleccion        -> seleccion_actual (idem)
NOTA: el handler de /flujos/nube/datos se ELIMINO: la nube de Text TOPs fue
reemplazada por las elecciones con botones (Replicator COMP). Ver AGENTS.md.
"""

# Raiz del proyecto (cambiar si no es /project2)
_ROOT = op("/project2")


def onReceiveOSC(dat, rowIndex, message, bytes, timeStamp, address, args, peer):
    """Se ejecuta por cada mensaje OSC entrante."""
    try:
        _enrutar(address, args)
    except Exception as e:
        print(f"[osc_callbacks] Error en {address}: {e}")


def _enrutar(address, args):
    """Enruta segun direccion OSC."""

    # ---- Lista de colores ---------------------------------------
    if address == "/flujos/colores":
        tabla = _ROOT.op("tabla_colores")
        if not tabla:
            return
        tabla.clear()
        tabla.appendRow(["color"])
        for c in args:
            tabla.appendRow([str(c)])
        print(f"[TD] Recibidos {len(args)} colores")
        return

    if address == "/colores":
        if not args:
            return
        txt = _ROOT.op("color_actual")
        if txt:
            txt.par.text = str(args[0])
        tabla = _ROOT.op("tabla_colores")
        if tabla:
            tabla.appendRow([str(args[0])])
        return

    # ---- Slideshow / Imagenes -----------------------------------
    if address in ("/flujos/slideshow/imagen", "/slideshow/imagen"):
        if len(args) < 1:
            return
        ruta = str(args[0])
        media_id = str(args[1]) if len(args) > 1 else ""
        color_tag = str(args[2]) if len(args) > 2 else ""

        movie = _ROOT.op("movie1")
        if movie:
            movie.par.file = ruta
            movie.par.play = 1

        info = _ROOT.op("info_imagen")
        if info:
            info.par.text = f"ID: {media_id} | Color: {color_tag}"
        return

    # ---- Elecciones (nubes de metadatos seleccionables) -----------
    # Formato OSC: /flujos/elecciones/<id> "<titulo>" <n> <valor1> <peso1> ...
    # Se guarda en la tabla TD: elec_<id> con columnas [titulo, valor, peso]
    if address.startswith("/flujos/elecciones/"):
        grupo_id = address.replace("/flujos/elecciones/", "")
        tabla = _ROOT.op("elec_" + grupo_id)
        if not tabla:
            print(f"[TD] Tabla elec_{grupo_id} no encontrada. Crear Table DAT 'elec_{grupo_id}'.")
            return

        # args[0]=titulo, args[1]=n, luego pares (valor, peso)
        titulo = str(args[0]) if len(args) > 0 else ""
        n = int(args[1]) if len(args) > 1 else 0

        tabla.clear()
        tabla.appendRow(["titulo", "valor", "peso"])
        idx = 2
        while idx + 1 < len(args):
            valor = str(args[idx])
            peso = float(args[idx + 1]) if isinstance(args[idx + 1], (int, float)) else 0.0
            tabla.appendRow([titulo, valor, str(round(peso, 3))])
            idx += 2

        print(f"[TD] Elecciones {grupo_id}: {n} items")
        return

    # ---- Seleccion del visitante --------------------------------
    if address == "/flujos/seleccion":
        if not args:
            return
        seleccion = str(args[0])
        txt = _ROOT.op("seleccion_actual")
        if txt:
            txt.par.text = seleccion
        print(f"[TD] Visitante selecciono: {seleccion}")
        return
